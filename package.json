{
  "name": "tmp-scaffold",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --host 127.0.0.1",
    "start:lan": "docusaurus start --host 0.0.0.0",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "echo 'Production deploys run from GitHub Actions. Validate with npm run build and push to main instead.' >&2 && exit 1",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "audit:policy": "npm audit --audit-level=high && node -e \"console.log('Audit policy passed: no high or critical vulnerabilities found. Remaining Docusaurus dev-server findings stay tracked in README.md with owner and review triggers.')\"",
    "release:check": "python3 ${XRTM_RELEASE_CHECKER:-scripts/check_release_claims.py} --repo-root . --scope xrtm.org --contract ${XRTM_RELEASE_CONTRACT:-scripts/release-command-contract.json}"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "framer-motion": "^12.29.0",
    "lucide-react": "^0.563.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10 <11"
  },
  "overrides": {
    "copy-webpack-plugin": "14.0.0",
    "css-minimizer-webpack-plugin": "8.0.0",
    "mermaid": {
      "uuid": "14.0.0"
    }
  }
}
