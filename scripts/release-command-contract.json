{
  "release_version": "0.9.2",
  "summary": "Release-gated command claims for xrtm.org site docs.",
  "allowed_claims": [
    "pip install xrtm",
    "pip install xrtm-forecast",
    "pip install xrtm-data",
    "pip install xrtm-eval",
    "pip install xrtm-train",
    "xrtm --help",
    "xrtm --version",
    "xrtm start",
    "xrtm start --limit 10",
    "xrtm start --model your-model --base-url https://your-endpoint",
    "xrtm start --model your-model --base-url https://your-endpoint --limit 10",
    "xrtm doctor",
    "xrtm runs show --latest",
    "xrtm runs show 20260607T010836Z-abc",
    "pip install xrtm==0.9.2",
    "xrtm runs show <run-id>"
  ],
  "scopes": {
    "xrtm.org": {
      "files": [
        "docs/getting-started.md",
        "docs/cli.md",
        "docs/framework.md",
        "docs/architecture.md",
        "src/pages/index.tsx"
      ]
    }
  }
}